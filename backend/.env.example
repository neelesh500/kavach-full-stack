MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
DB_NAME=exam_auth
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000
# Set to true to require the Firebase email to also exist in MongoDB `admins`
ADMIN_REQUIRE_MONGODB_ADMINS=false

# Firebase Auth (admin email/password login)
FIREBASE_API_KEY=<your-firebase-api-key>
FIREBASE_PROJECT_ID=<your-firebase-project-id>
FIREBASE_AUTH_DOMAIN=<your-project>.firebaseapp.com
FIREBASE_ADMIN_EMAIL=admin@exam.gov

# reCAPTCHA Enterprise (https://cloud.google.com/recaptcha-enterprise)
# Set RECAPTCHA_ENABLED=true to turn the check on
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=<your-recaptcha-site-key>
RECAPTCHA_PROJECT_ID=<your-gcp-project-id>
RECAPTCHA_API_KEY=<your-gcp-api-key>
RECAPTCHA_MIN_SCORE=0.5
# Dev/test only: a token value that is accepted as verified without a Google call
RECAPTCHA_TEST_TOKEN=recaptcha-test-bypass-token
